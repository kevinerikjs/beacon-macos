<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Beacon is distributed via Developer ID (not Mac App Store), so the
	     App Sandbox is intentionally omitted. Sandbox blocks AXIsProcessTrusted
	     prompts and CGEvent posting — both required for media key forwarding. -->

	<!-- Hardened Runtime exceptions needed for ScreenCaptureKit -->
	<key>com.apple.security.cs.allow-jit</key>
	<false/>

	<!-- Virtual HID gamepad for controller passthrough (IOHIDUserDevice, macOS 13+).
	     APPROVAL-GATED: this capability must be granted by Apple to the team before a
	     build carrying it will sign/run (request via developer portal). Until approval,
	     keep it commented out — VirtualGamepad fails gracefully at runtime without it.
	<key>com.apple.developer.hid.virtual.device</key>
	<true/>
	-->

</dict>
</plist>
