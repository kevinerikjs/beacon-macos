<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Beacon is distributed via Developer ID (not Mac App Store), so the
	     App Sandbox is intentionally omitted. Sandbox blocks AXIsProcessTrusted
	     prompts and CGEvent posting — both required for media key forwarding. -->

	<!-- Hardened Runtime exceptions needed for ScreenCaptureKit -->
	<key>com.apple.security.cs.allow-jit</key>
	<false/>
</dict>
</plist>
